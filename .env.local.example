# One Arc network per deployment. Rebuild after changing NEXT_PUBLIC values.
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_ESCROW_ADDRESS=
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
# Optional server-only RPC URL for credentialed access.
# ARC_RPC_URL=

# Privy: public app ID in browser; secret only on the server.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Supabase: server-only. Apply both SQL migrations before using backups/claims.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes as 64 hexadecimal characters. Keep a secure backup.
BEAM_BACKUP_ENCRYPTION_KEY=

# Dedicated funded relayer on the configured Arc network. Server-only.
RELAYER_PRIVATE_KEY=
RELAYER_MAX_CLAIM_FEE_USDC=0.1
RELAYER_DAILY_BUDGET_USDC=10

# DEPLOYER_PRIVATE_KEY and CONFIRM_DEPLOY_CHAIN_ID are local operator settings
# for deploy:escrow only. Never prefix private keys with NEXT_PUBLIC_.
